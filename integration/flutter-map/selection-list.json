{
  "element": "cds-selection-list",
  "defaults": {
    "kind": "default",
    "trailing-item": "checkbox"
  },
  "curated": true,
  "widget": {
    "class": "CastanhaSelectionList",
    "args": [
      {
        "param": "children",
        "each": "cds-selection-list-item",
        "widget": {
          "class": "CastanhaSelectionListItem",
          "args": [
            {
              "param": "label",
              "attr": "label"
            },
            {
              "param": "onChanged",
              "code": "(_) {}"
            },
            {
              "param": "description",
              "attr": "description",
              "if": {
                "show-description": "!false"
              }
            },
            {
              "param": "leadItem",
              "code": "CastanhaSelectionListLeadItem.icon(CastanhaIcon(icon: CastanhaIcons.{c:lead-icon}))",
              "if": {
                "show-lead-item": "!false"
              }
            },
            {
              "param": "trailingItem",
              "code": "const CastanhaSelectionListTrailingItem.checkbox()",
              "if": {
                "trailing-item": "checkbox"
              }
            },
            {
              "param": "trailingItem",
              "code": "const CastanhaSelectionListTrailingItem.checkbox()",
              "if": {
                "trailing-item": "chechbox"
              }
            },
            {
              "param": "trailingItem",
              "code": "const CastanhaSelectionListTrailingItem.radioButton()",
              "if": {
                "trailing-item": "radio-button"
              }
            },
            {
              "param": "trailingItem",
              "code": "const CastanhaSelectionListTrailingItem.switch_()",
              "if": {
                "trailing-item": "switch"
              }
            },
            {
              "param": "trailingItem",
              "code": "CastanhaSelectionListTrailingItem.icon(CastanhaIcon(icon: CastanhaIcons.{c:trailing-icon}))",
              "if": {
                "trailing-item": "icon"
              }
            },
            {
              "param": "trailingItem",
              "code": "CastanhaSelectionListTrailingItem.tag(CastanhaTag(label: {q:tag-label}))",
              "if": {
                "trailing-item": "tag"
              }
            },
            {
              "param": "selected",
              "attr": "is-active",
              "bool": true
            },
            {
              "param": "hideDivider",
              "attr": "show-divider",
              "bool": "not"
            },
            {
              "param": "disabled",
              "attr": "disabled",
              "bool": true
            }
          ],
          "defaults": {
            "kind": "default",
            "label": "Label",
            "description": "Description",
            "show-description": "true",
            "show-lead-item": "true",
            "show-divider": "true",
            "lead-icon": "placeholder-line",
            "trailing-item": "checkbox",
            "tag-label": "Tag",
            "trailing-icon": "placeholder-line"
          }
        }
      },
      {
        "param": "kind",
        "attr": "kind"
      }
    ]
  },
  "figma": [
    [
      "Kind",
      "kind",
      "kind",
      "Repassado aos itens."
    ],
    [
      "—",
      "trailing-item",
      "trailingItem (de cada item)",
      "Checkbox para seleção múltipla, Radio Button para única."
    ],
    [
      "—",
      "(filhos)",
      "children",
      "Um `CastanhaSelectionListItem` por opção, cada um com `selected`."
    ]
  ]
}
