{
  "element": "cds-nav-control",
  "defaults": {
    "appearance": "accent",
    "current": "1",
    "total": "10",
    "prev-label": "Anterior",
    "next-label": "Próximo"
  },
  "curated": true,
  "widget": {
    "class": "CastanhaNavControl",
    "args": [
      {
        "param": "activeIndex",
        "attr": "current",
        "num": true,
        "offset": -1
      },
      {
        "param": "itemCount",
        "attr": "total",
        "num": true
      },
      {
        "param": "appearance",
        "attr": "appearance",
        "map": {
          "inversed": "inverted"
        }
      },
      {
        "param": "onChanged",
        "code": "(_) {}"
      }
    ]
  },
  "figma": [
    [
      "Appearance",
      "appearance",
      "appearance",
      "Inversed vira `inverted`."
    ],
    [
      "—",
      "total",
      "itemCount",
      "Obrigatório."
    ],
    [
      "—",
      "current",
      "activeIndex",
      "O playground conta a partir de 1; o Flutter, de 0."
    ],
    [
      "—",
      "prev-label / next-label",
      "—",
      "Os rótulos acessíveis vêm do widget."
    ]
  ]
}
