{
  "element": "cds-shaped-icon",
  "defaults": { "icon": "placeholder-line", "appearance": "neutral", "size": "smallest" },
  "jsx": {
    "tag": "ShapedIcon",
    "props": [
      { "prop": "icon", "attr": "icon" },
      { "prop": "appearance", "attr": "appearance", "map": { "inversed": "inverted" }, "if": { "appearance": "!accent" } },
      { "prop": "size", "attr": "size", "map": { "smallest": "small", "small": "medium", "medium": "large", "large": "largest" }, "if": { "size": "!small" } },
      { "prop": "aria-label", "attr": "label" }
    ]
  },
  "figma": [
    ["Icon", "icon", "icon", "Nome do ícone (`IconName`)."],
    ["Appearance", "appearance", "appearance", "Inversed vira `inverted`. O padrão do Figma é Neutral; o do React é `accent` — declare a prop."],
    ["Size", "size", "size", "Os nomes andam um passo: Smallest → `small`, Small → `medium`, Medium → `large`, Large → `largest`. O padrão do React é `medium` (Small no Figma)."],
    ["—", "label", "aria-label", "Sem nome, é decorativo."]
  ]
}
