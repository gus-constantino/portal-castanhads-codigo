{
  "element": "cds-caju-brand",
  "defaults": { "kind": "default", "show-typography": "true", "label": "Caju" },
  "jsx": {
    "tag": "CajuBrand",
    "props": [
      { "prop": "kind", "attr": "kind", "map": { "inversed": "inverted" } },
      { "prop": "hasTypography", "attr": "show-typography", "bool": true },
      { "prop": "aria-label", "attr": "label", "if": { "label": "!Caju" } }
    ]
  },
  "figma": [
    ["Kind", "kind", "kind", "Inversed vira `inverted`."],
    ["Show Typography", "show-typography", "hasTypography", "False: `hasTypography={false}` (só o símbolo)."],
    ["—", "label", "aria-label", "Nome acessível; padrão \"Caju\"."]
  ]
}
