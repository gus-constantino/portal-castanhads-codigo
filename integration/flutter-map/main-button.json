{
  "element": "cds-main-button",
  "defaults": {
    "kind": "default",
    "appearance": "accent",
    "size": "medium",
    "label": "Label",
    "show-lead-icon": "true",
    "show-trailing-icon": "true",
    "lead-icon": "placeholder-line",
    "trailing-icon": "placeholder-line"
  },
  "curated": true,
  "widget": {
    "class": "CastanhaMainButton",
    "args": [
      {
        "param": "label",
        "attr": "label"
      },
      {
        "param": "onPressed",
        "code": "() {}"
      },
      {
        "param": "kind",
        "attr": "kind"
      },
      {
        "param": "appearance",
        "attr": "appearance",
        "map": {
          "inversed": "inverted"
        }
      },
      {
        "param": "size",
        "attr": "size"
      },
      {
        "param": "disabled",
        "attr": "disabled",
        "bool": true
      },
      {
        "param": "leadIcon",
        "attr": "lead-icon",
        "icon": true,
        "if": {
          "show-lead-icon": "true"
        }
      },
      {
        "param": "showTrailingIcon",
        "attr": "show-trailing-icon",
        "bool": true
      }
    ]
  },
  "figma": [
