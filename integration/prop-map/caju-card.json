{
  "element": "cds-caju-card",
  "defaults": { "kind": "fisico", "orientation": "vertical", "side": "front" },
  "jsx": {
    "tag": "CajuCard",
    "props": [
      { "prop": "kind", "attr": "kind", "map": { "virtual": "virtual-credito", "virtual-corporativo": "virtual-credito-corporativo" } },
      { "prop": "orientation", "attr": "orientation", "if": { "orientation": "!vertical" } },
      { "prop": "sideView", "attr": "side", "if": { "side": "!front" } },
      { "prop": "blocked", "attr": "blocked", "bool": true },
      { "prop": "fullCardNumber", "attr": "full-card-number" },
      { "prop": "cvv", "attr": "cvv", "num": true },
      { "prop": "expirationDate", "attr": "expiration-date" },
      { "prop": "activationCode", "attr": "activation-code" },
      { "prop": "aria-label", "attr": "label" }
    ]
  },
  "figma": [
    ["Kind", "kind", "kind", "Obrigatório. Virtual/Credito → `virtual-credito`; Virtual/Credito Corporativo → `virtual-credito-corporativo`."],
    ["Orientation", "orientation", "orientation", "Padrão vertical nos dois lados."],
    ["Side View", "side", "sideView", "Padrão `front`."],
    ["Is Blocked", "blocked", "blocked", "Escurece a arte e mostra o cadeado."],
    ["Full Card Number", "full-card-number", "fullCardNumber", "Só nos cartões virtuais; o React mostra mascarado com os 4 últimos dígitos."],
    ["CVV", "cvv", "cvv", "Número, no verso."],
    ["Expiration Date", "expiration-date", "expirationDate", "No verso."],
    ["Activation Code", "activation-code", "activationCode", "No verso."]
  ]
}
